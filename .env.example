# Address of the .NET backend (PostBank.Api). server.ts forwards every /api request that is not an AI route to it.
BACKEND_URL=http://localhost:5251

PORT=3000

# Set to 1 ONLY when this server runs behind a reverse proxy (IIS / nginx) that sets X-Forwarded-For and
# X-Forwarded-Proto. Without it a client-sent X-Forwarded-For is ignored, so nobody can fake their address.
TRUST_PROXY=0

# Largest request body (uploads) forwarded to the backend, in megabytes.
MAX_BODY_MB=200
