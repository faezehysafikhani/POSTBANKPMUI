{
  "name": "ptms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "build:settings": "tailwindcss -i tmpb/reference.css -o tmpb/generated.css --minify",
    "predev": "npm run build:settings",
    "prebuild": "npm run build:settings",
    "check:org-rules": "node --import tsx scripts/check-org-rules.ts",
    "check:org-tidy": "node --import tsx scripts/check-org-tidy.ts",
    "check:org-mocks": "node --import tsx scripts/check-org-mocks.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.11",
    "html2canvas": "^1.4.1",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "lucide-react": "^0.546.0",
    "@microsoft/signalr": "^8.0.29",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "tailwindcss": "^4.1.14",
    "@tailwindcss/cli": "^4.1.14"
  }
}
